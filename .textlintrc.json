{
  "rules": {
    "preset-ja-technical-writing": {
      "ja-no-mixed-period": {
        "allowEmojiAtEnd": true,
        "allowPeriodMarks": [":"]
      },
      "no-exclamation-question-mark": {
        "allow": ["ロリポップ！"]
      }
    },
    "preset-ai-writing": {
      "ai-tech-writing-guideline": {
        "allows": ["/する必要があ/"]
      }
    }
  }
}
